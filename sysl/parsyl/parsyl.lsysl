parsyl — combinator parser library
===================================

Sysl port of the Scala reference at
`shared/src/main/scala/io/github/edadma/parsyl/Parsers.scala`. Targets
sysl `dev`.

    import std.option.{Option, Some, None}
    import std.bytes.{as_bytes, has_prefix}
    import std.utf8.{decode_rune}


Input
-----

    struct Input
        source: []byte
        offset: int

    Input.at_end() -> bool = self.offset >= len(self.source)
    Input.advance(n: int) -> Input = Input(self.source, self.offset + n)

`mk_input(s)` is the conversational entry point — converts a string to
the byte-slice-backed `Input` once at the boundary. Past that, all
parser combinators work in bytes (zero-copy slicing, UTF-8 decoding via
`std.utf8`).

    mk_input(s: string) -> Input = Input(as_bytes(s), 0)


ParseResult
-----------

    enum ParseResult[A]
        Success(value: A, next: Input)
        Failure(msg: string, at: Input)


Parser
------

    type Parser[A] = new (Input) -> ParseResult[A]


Trivial parsers
---------------

    success[A](v: A) -> Parser[A] =
        Parser[A]((inp: Input) -> Success(v, inp))

    failure[A](msg: string) -> Parser[A] =
        Parser[A]((inp: Input) -> Failure(msg, inp))


eoi
---

    eoi -> Parser[unit] =
        Parser[unit]((inp: Input) ->
            if inp.at_end() then Success((), inp)
            else Failure("expected end of input", inp))


map
---

    map[A, B](p: Parser[A], f: (A) -> B) -> Parser[B] =
        Parser[B]((inp: Input) ->
            p(inp) match
                Success(v, n) -> Success(f(v), n)
                Failure(m, n) -> Failure(m, n))


seq
---

`seq` runs `p` then `q`, returning the pair. `seq_l` and `seq_r` are the
"keep left" / "keep right" variants — used heavily for skipping
delimiters.

    seq[A, B](p: Parser[A], q: Parser[B]) -> Parser[(A, B)] =
        Parser[(A, B)]((inp: Input) ->
            p(inp) match
                Failure(m, n) -> Failure(m, n)
                Success(va, na) ->
                    q(na) match
                        Failure(m, n) -> Failure(m, n)
                        Success(vb, nb) -> Success((va, vb), nb))

    seq_l[A, B](p: Parser[A], q: Parser[B]) -> Parser[A] =
        p ~ q ^^ ((t: (A, B)) -> t._0)

    seq_r[A, B](p: Parser[A], q: Parser[B]) -> Parser[B] =
        p ~ q ^^ ((t: (A, B)) -> t._1)


flat_map
--------

    flat_map[A, B](p: Parser[A], f: (A) -> Parser[B]) -> Parser[B] =
        Parser[B]((inp: Input) ->
            p(inp) match
                Success(v, n) -> f(v)(n)
                Failure(m, n) -> Failure(m, n))


or
--

    or[A](p: Parser[A], q: Parser[A]) -> Parser[A] =
        Parser[A]((inp: Input) ->
            p(inp) match
                Success(v, n) -> Success(v, n)
                Failure(_, _) -> q(inp))


opt
---

    opt[A](p: Parser[A]) -> Parser[Option[A]] =
        Parser[Option[A]]((inp: Input) ->
            p(inp) match
                Success(v, n) -> Success(Some(v), n)
                Failure(_, _) -> Success(None, inp))


rep
---

Zero or more applications of `p`. The no-progress check
(`n.offset > current.offset`) defends against a parser that succeeds
without consuming input, which would otherwise loop forever.

    rep[A](p: Parser[A]) -> Parser[[]A] =
        Parser[[]A]((inp: Input) ->
            var result: []A = []
            var current = inp
            var more = true
            while more do
                p(current) match
                    Success(v, n) ->
                        if n.offset > current.offset then
                            result = append(result, v)
                            current = n
                        else
                            more = false
                    Failure(_, _) -> more = false
            Success(result, current))


rep1
----

One or more applications of `p`.

    rep1[A](p: Parser[A]) -> Parser[[]A] =
        Parser[[]A]((inp: Input) ->
            p(inp) match
                Failure(m, n) -> Failure(m, n)
                Success(first, after) ->
                    var result: []A = [first]
                    var current = after
                    var more = true
                    while more do
                        p(current) match
                            Success(v, n) ->
                                if n.offset > current.offset then
                                    result = append(result, v)
                                    current = n
                                else
                                    more = false
                            Failure(_, _) -> more = false
                    Success(result, current))


chainl1
-------

Left-associative fold. `operand` parses a single value; `op` parses a
binary combiner. `a OP b OP c` becomes `(a OP b) OP c`.

    chainl1[A](operand: Parser[A], op: Parser[(A, A) -> A]) -> Parser[A] =
        Parser[A]((inp: Input) ->
            operand(inp) match
                Failure(m, n) -> Failure(m, n)
                Success(first, after) ->
                    var acc = first
                    var current = after
                    var more = true
                    while more do
                        op(current) match
                            Failure(_, _) -> more = false
                            Success(f, n1) ->
                                operand(n1) match
                                    Failure(_, _) -> more = false
                                    Success(v, n2) ->
                                        acc = f(acc, v)
                                        current = n2
                    Success(acc, current))


Operators
---------

Combinator-style infix operators via the user-defined-operator and
multi-param-trait machinery. `~` for sequence, `|` for alternation,
`~>` and `<~` for sequence-keep-right / sequence-keep-left, `^^` for
map, `^^^` for replace-with-constant.

    trait Concat[A, B, R]
        #operator("~")
        concat(a: A, b: B) -> R

    impl[A, B] Concat[Parser[A], Parser[B], Parser[(A, B)]]
        concat(a: Parser[A], b: Parser[B]) -> Parser[(A, B)] = seq(a, b)

    trait Or[T]
        #operator("|")
        or_op(a: T, b: T) -> T

    impl[A] Or[Parser[A]]
        or_op(a: Parser[A], b: Parser[A]) -> Parser[A] = or(a, b)

    trait SeqR[A, B, R]
        #operator("~>")
        seqr(a: A, b: => B) -> R

    impl[A, B] SeqR[Parser[A], Parser[B], Parser[B]]
        seqr(a: Parser[A], b: => Parser[B]) -> Parser[B] =
            Parser[B]((inp: Input) ->
                a(inp) match
                    Failure(m, n) -> Failure(m, n)
                    Success(_, na) -> b(na))

    trait SeqL[A, B, R]
        #operator("<~")
        seql(a: A, b: => B) -> R

    impl[A, B] SeqL[Parser[A], Parser[B], Parser[A]]
        seql(a: Parser[A], b: => Parser[B]) -> Parser[A] =
            Parser[A]((inp: Input) ->
                a(inp) match
                    Failure(m, n) -> Failure(m, n)
                    Success(va, na) ->
                        b(na) match
                            Failure(m, n) -> Failure(m, n)
                            Success(_, nb) -> Success(va, nb))

    trait Map[A, F, R]
        #operator("^^")
        pmap(a: A, f: F) -> R

    impl[A, B] Map[Parser[A], (A) -> B, Parser[B]]
        pmap(a: Parser[A], f: (A) -> B) -> Parser[B] = map(a, f)

    trait MapTo[A, V, R]
        #operator("^^^")
        pmapto(a: A, v: V) -> R

    impl[A, B] MapTo[Parser[A], B, Parser[B]]
        pmapto(a: Parser[A], v: B) -> Parser[B] = map(a, (_: A) -> v)

    impl[B] MapTo[string, B, Parser[B]]
        pmapto(s: string, v: B) -> Parser[B] = map(lex(literal(s)), (_: string) -> v)

    impl[B] Map[string, (string) -> B, Parser[B]]
        pmap(s: string, f: (string) -> B) -> Parser[B] = map(lex(literal(s)), f)

A string literal in operator position lifts itself to `lex(literal(s))`
— skips surrounding whitespace and matches the token. Lets grammars
read like the Scala parser-combinator idiom: `"(" ~> expr <~ ")"`.

    impl[B] Concat[string, Parser[B], Parser[(string, B)]]
        concat(s: string, b: Parser[B]) -> Parser[(string, B)] = seq(lex(literal(s)), b)

    impl[A] Concat[Parser[A], string, Parser[(A, string)]]
        concat(a: Parser[A], s: string) -> Parser[(A, string)] = seq(a, lex(literal(s)))

    impl[B] SeqR[string, Parser[B], Parser[B]]
        seqr(s: string, b: => Parser[B]) -> Parser[B] =
            val sp = lex(literal(s))
            Parser[B]((inp: Input) ->
                sp(inp) match
                    Failure(m, n) -> Failure(m, n)
                    Success(_, na) -> b(na))

    impl[A] SeqR[Parser[A], string, Parser[string]]
        seqr(a: Parser[A], s: => string) -> Parser[string] = seq_r(a, lex(literal(s)))

    impl[B] SeqL[string, Parser[B], Parser[string]]
        seql(s: string, b: => Parser[B]) -> Parser[string] =
            val sp = lex(literal(s))
            Parser[string]((inp: Input) ->
                sp(inp) match
                    Failure(m, n) -> Failure(m, n)
                    Success(va, na) ->
                        b(na) match
                            Failure(m, n) -> Failure(m, n)
                            Success(_, nb) -> Success(va, nb))

    impl[A] SeqL[Parser[A], string, Parser[A]]
        seql(a: Parser[A], s: => string) -> Parser[A] = seq_l(a, lex(literal(s)))


chainr1
-------

Right-associative fold. `a OP b OP c` becomes `a OP (b OP c)`.

    chainr1[A](operand: Parser[A], op: Parser[(A, A) -> A]) -> Parser[A] =
        Parser[A]((inp: Input) ->
            operand(inp) match
                Failure(m, n) -> Failure(m, n)
                Success(first, after) ->
                    var values: []A = [first]
                    var ops: [](A, A) -> A = []
                    var current = after
                    var more = true
                    while more do
                        op(current) match
                            Failure(_, _) -> more = false
                            Success(f, n1) ->
                                operand(n1) match
                                    Failure(_, _) -> more = false
                                    Success(v, n2) ->
                                        ops = append(ops, f)
                                        values = append(values, v)
                                        current = n2
                    var acc = values[len(values) - 1]
                    var i = len(values) - 2
                    while i >= 0 do
                        acc = ops[i](values[i], acc)
                        i = i - 1
                    Success(acc, current))


lazy_p
------

Defer parser construction until invocation. For non-left-recursive
grammars where wrapping the body in a closure would be awkward.

    lazy_p[A](thunk: () -> Parser[A]) -> Parser[A] =
        Parser[A]((inp: Input) -> thunk()(inp))


repsep / rep1sep
----------------

`p` separated by `sep`. `repsep` allows zero matches; `rep1sep` requires
at least one. The trailing-sep case (sep succeeds but `p` fails) is
treated as a hard failure — we'd already committed to the separator.

    rep1sep[A, S](p: Parser[A], sep: Parser[S]) -> Parser[[]A] =
        Parser[[]A]((inp: Input) ->
            p(inp) match
                Failure(m, n) -> Failure(m, n)
                Success(first, after) ->
                    var result: []A = [first]
                    var current = after
                    var status: ParseResult[[]A] = Success(result, current)
                    var more = true
                    while more do
                        sep(current) match
                            Failure(_, _) ->
                                status = Success(result, current)
                                more = false
                            Success(_, n1) ->
                                p(n1) match
                                    Failure(m, n) ->
                                        status = Failure(m, n)
                                        more = false
                                    Success(v, n2) ->
                                        result = append(result, v)
                                        current = n2
                    status)

    repsep[A, S](p: Parser[A], sep: Parser[S]) -> Parser[[]A] =
        rep1sep(p, sep) | success[[]A]([])


accept_if
---------

Read one byte if it satisfies the predicate. `label` is woven into the
failure message — pass something the user can act on like `"digit"` or
`"alpha"`.

    accept_if(label: string, pred: (char) -> bool) -> Parser[char] =
        Parser[char]((inp: Input) ->
            if inp.at_end() then
                Failure(s"expected ${label}, got end of input", inp)
            else
                val (c, n) = decode_rune(inp.source[inp.offset : len(inp.source)])
                if pred(c) then Success(c, inp.advance(n))
                else Failure(s"expected ${label}", inp))


literal
-------

Match a literal string prefix. Uses `std.strings.has_prefix` over the
unconsumed slice — empty string matches at every position.

    literal(s: string) -> Parser[string] =
        val sb = as_bytes(s)
        Parser[string]((inp: Input) ->
            val rest = inp.source[inp.offset : len(inp.source)]
            if has_prefix(rest, sb) then
                Success(s, inp.advance(len(sb)))
            else
                Failure(s"expected literal '${s}'", inp))


skip_ws / lex
-------------

ASCII whitespace handling. `skip_ws(p)` skips leading whitespace, then
runs `p`. `lex(p)` runs `skip_ws(p)` and additionally consumes trailing
whitespace, so lex-built parsers compose naturally — each leaves the
cursor on the next non-whitespace byte.

    is_ws_byte(b: byte) -> bool =
        b == 0x20u8 || b == 0x09u8 || b == 0x0Au8 || b == 0x0Du8

    skip_ws[A](p: Parser[A]) -> Parser[A] =
        Parser[A]((inp: Input) ->
            var i = inp.offset
            while i < len(inp.source) && is_ws_byte(inp.source[i]) do
                i = i + 1
            p(Input(inp.source, i)))

    lex[A](p: Parser[A]) -> Parser[A] =
        Parser[A]((inp: Input) ->
            skip_ws(p)(inp) match
                Failure(m, n) -> Failure(m, n)
                Success(v, after) ->
                    var j = after.offset
                    while j < len(after.source) && is_ws_byte(after.source[j]) do
                        j = j + 1
                    Success(v, Input(after.source, j)))


parse_all
---------

Top-level entry: skip leading whitespace, run `p`, then require the
input to be exhausted (modulo trailing whitespace).

    parse_all[A](p: Parser[A], src: string) -> ParseResult[A] =
        skip_ws(p <~ skip_ws(eoi))(mk_input(src))


Expression-grammar demo
-----------------------

The headline showcase: a four-operator integer-arithmetic grammar with
`+ - * /`, left-associative within each precedence level, parenthesized
sub-expressions, and arbitrary whitespace between tokens. The whole
grammar is six function bodies — every interesting line uses one of the
operators (`~>`, `<~`, `|`, `^^`, `^^^`) or `chainl1`.

    digit -> Parser[char] =
        accept_if("digit", (c: char) -> '0' <= c <= '9')

    digits_to_int(cs: []char) -> int =
        var n = 0
        for i in 0..<len(cs) do
            n = n * 10 + int(cs[i] - '0')
        n

    number -> Parser[int] =
        lex(rep1(digit) ^^ ((cs: []char) -> digits_to_int(cs)))

The op parsers each consume their token (with surrounding whitespace via
`lex`) and return a binary `(int, int) -> int` combiner — exactly the
shape `chainl1` consumes.

The grammar itself. `factor` recurses back through `expr` for the
parenthesized case; the `~>` and `<~` impls take their second arg
by-name (`b: => Parser[B]`), so the recursive `expr` call defers to
parse time and we don't loop at construction. Op tables are inlined:
each `"X" ^^^ (_ OP _)` lifts a token to a binary combiner.

    expr -> Parser[int] =
        chainl1(term, ("+" ^^^ (_ + _)) | ("-" ^^^ (_ - _)))

    term -> Parser[int] =
        chainl1(factor, ("*" ^^^ (_ * _)) | ("/" ^^^ (_ / _)))

    factor -> Parser[int] =
        number | ("(" ~> expr <~ ")") | (("-" ~> factor) ^^ (-_))


AST-building expression parser
------------------------------

Same grammar, but the parser returns a syntax tree instead of computing
the value inline. A separate `eval` walks the tree. This mirrors the
shape of a real compiler frontend: parser produces typed AST, downstream
passes consume it (typecheck, optimize, evaluate, codegen).

    enum Expr
        Num(value: int)
        Add(left: Expr, right: Expr)
        Sub(left: Expr, right: Expr)
        Mul(left: Expr, right: Expr)
        Div(left: Expr, right: Expr)
        Neg(operand: Expr)

    eval(e: Expr) -> int =
        e match
            Num(v) -> v
            Add(l, r) -> eval(l) + eval(r)
            Sub(l, r) -> eval(l) - eval(r)
            Mul(l, r) -> eval(l) * eval(r)
            Div(l, r) -> eval(l) / eval(r)
            Neg(o) -> -eval(o)

The parser. Same shape as before, but each combiner constructs an
`Expr` node instead of folding an `int`.

    enumber -> Parser[Expr] =
        lex(rep1(digit) ^^ ((cs: []char) -> Num(digits_to_int(cs))))

    eexpr -> Parser[Expr] =
        chainl1(eterm,
            ("+" ^^^ ((a: Expr, b: Expr) -> Add(a, b))) |
                ("-" ^^^ ((a: Expr, b: Expr) -> Sub(a, b))))

    eterm -> Parser[Expr] =
        chainl1(efactor,
            ("*" ^^^ ((a: Expr, b: Expr) -> Mul(a, b))) |
                ("/" ^^^ ((a: Expr, b: Expr) -> Div(a, b))))

    efactor -> Parser[Expr] =
        enumber | ("(" ~> eexpr <~ ")") | (("-" ~> efactor) ^^ ((e: Expr) -> Neg(e)))


Tests
-----

    #test
    test_success() -> unit
        val p = success[int](42)
        p(Input(as_bytes("hello"), 0)) match
            Success(v, _) -> expect(v, 42, "success returns its value")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_failure() -> unit
        val p = failure[int]("nope")
        p(Input(as_bytes("hello"), 0)) match
            Success(_, _) -> panic("failure should not succeed")
            Failure(_, _) -> ()

    #test
    test_end_at_end() -> unit
        val p = eoi
        p(Input(as_bytes("ab"), 2)) match
            Success(_, _) -> ()
            Failure(_, _) -> panic("end should succeed at end of input")

    #test
    test_end_not_at_end() -> unit
        val p = eoi
        p(Input(as_bytes("ab"), 0)) match
            Success(_, _) -> panic("end should fail mid-input")
            Failure(_, _) -> ()

    #test
    test_map() -> unit
        val p: Parser[int] = map(success[int](21), (x: int) -> x * 2)
        p(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 42, "map doubles")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_seq_success() -> unit
        val p = seq(success[int](1), success[int](2))
        p(Input(as_bytes(""), 0)) match
            Success((a, b), _) ->
                expect(a, 1, "seq first")
                expect(b, 2, "seq second")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_or_first() -> unit
        val p = or(success[int](1), success[int](2))
        p(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 1, "or takes the first success")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_or_fallback() -> unit
        val p = or(failure[int]("nope"), success[int](2))
        p(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 2, "or falls back to second on first failure")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_opt_some() -> unit
        val p = opt(success[int](7))
        p(Input(as_bytes(""), 0)) match
            Success(o, _) ->
                o match
                    Some(v) -> expect(v, 7, "opt-Some carries value")
                    None    -> panic("opt of success should be Some")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_opt_none() -> unit
        val p = opt(failure[int]("nope"))
        p(Input(as_bytes("hi"), 2)) match
            Success(o, n) ->
                expect(n.offset, 2, "opt of failure does not advance")
                o match
                    Some(_) -> panic("opt of failure should be None")
                    None    -> ()
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_rep_zero() -> unit
        val p = rep(failure[int]("nope"))
        p(Input(as_bytes("xx"), 0)) match
            Success(xs, n) ->
                expect(len(xs), 0, "rep of always-failing yields empty slice")
                expect(n.offset, 0, "rep does not advance on no matches")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_rep1_fail_on_zero() -> unit
        val p = rep1(failure[int]("nope"))
        p(Input(as_bytes("xx"), 0)) match
            Success(_, _) -> panic("rep1 should fail on zero matches")
            Failure(_, _) -> ()

    #test
    test_rep1_appends() -> unit
        // exercise the append path explicitly — the simple test cases above
        // never trigger it, masking any bug in [first] -> append(result, v).
        val p = rep1(literal("x"))
        p(Input(as_bytes("xxx"), 0)) match
            Success(vs, n) ->
                expect(len(vs), 3, "rep1 collects three xs")
                expect(n.offset, 3, "rep1 consumes all xs")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_seq_l() -> unit
        val p = seq_l(success[int](1), success[int](2))
        p(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 1, "seq_l keeps left")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_seq_r() -> unit
        val p = seq_r(success[int](1), success[int](2))
        p(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 2, "seq_r keeps right")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_flat_map() -> unit
        val p = flat_map(success[int](21), (x: int) -> success[int](x * 2))
        p(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 42, "flat_map chains")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_op_seq() -> unit
        val p = success[int](1) ~ success[int](2)
        p(Input(as_bytes(""), 0)) match
            Success((a, b), _) ->
                expect(a, 1, "~ first")
                expect(b, 2, "~ second")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_op_or() -> unit
        val p = failure[int]("nope") | success[int](2)
        p(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 2, "| falls back")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_op_seqr() -> unit
        val p = success[int](1) ~> success[int](2)
        p(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 2, "~> keeps right")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_op_seql() -> unit
        val p = success[int](1) <~ success[int](2)
        p(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 1, "<~ keeps left")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_op_map() -> unit
        val p: Parser[int] = success[int](21) ^^ ((x: int) -> x * 2)
        p(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 42, "^^ maps")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_op_mapto() -> unit
        val p: Parser[int] = success[int](999) ^^^ 7
        p(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 7, "^^^ replaces")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_chainl1() -> unit
        // smoke test: exercise the no-iteration path. `success[int](42)` consumes no
        // input but the op (`failure`) fails immediately, so chainl1 returns the
        // single operand. Using a non-failing op here would loop forever — both
        // operand and op succeed without consuming input.
        val no_op: Parser[(int, int) -> int] = failure[(int, int) -> int]("no op")
        val one_only: Parser[int] = chainl1(success[int](42), no_op)
        one_only(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 42, "chainl1 with no ops returns the operand")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_chainr1_no_op() -> unit
        // same shape as test_chainl1: no-iteration path, op fails immediately.
        val no_op: Parser[(int, int) -> int] = failure[(int, int) -> int]("no op")
        val one_only: Parser[int] = chainr1(success[int](42), no_op)
        one_only(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 42, "chainr1 with no ops returns the operand")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_lazy_p() -> unit
        // thunk evaluates lazily on each call; the underlying parser is just success(7).
        val p: Parser[int] = lazy_p[int](() -> success[int](7))
        p(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 7, "lazy_p delegates to thunked parser")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_literal_match() -> unit
        val p = literal("foo")
        p(Input(as_bytes("foobar"), 0)) match
            Success(v, n) ->
                expect(n.offset, 3, "literal advances by length")
                if v != "foo" then panic(s"unexpected value: ${v}")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_literal_no_match() -> unit
        val p = literal("foo")
        p(Input(as_bytes("bar"), 0)) match
            Success(_, _) -> panic("literal should have failed")
            Failure(_, n) -> expect(n.offset, 0, "literal does not consume on failure")

    #test
    test_accept_if_digit() -> unit
        val digit: Parser[char] =
            accept_if("digit", (c: char) -> '0' <= c <= '9')
        digit(Input(as_bytes("7x"), 0)) match
            Success(v, n) ->
                expect(n.offset, 1, "accept_if advances by one")
                if v != '7' then panic(s"unexpected codepoint")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_accept_if_at_end() -> unit
        val digit: Parser[char] =
            accept_if("digit", (c: char) -> '0' <= c <= '9')
        digit(Input(as_bytes(""), 0)) match
            Success(_, _) -> panic("should have failed at end of input")
            Failure(_, n) -> expect(n.offset, 0, "accept_if at end does not advance")

    #test
    test_repsep_zero() -> unit
        // empty input: repsep returns the empty vector via the success-fallback branch.
        val item = literal("x")
        val sep = literal(",")
        val p = repsep(item, sep)
        p(Input(as_bytes(""), 0)) match
            Success(vs, n) ->
                expect(len(vs), 0, "repsep on empty input returns []")
                expect(n.offset, 0, "no consumption")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_rep1sep_basic() -> unit
        val item = literal("x")
        val sep = literal(",")
        val p = rep1sep(item, sep)
        p(Input(as_bytes("x,x,x"), 0)) match
            Success(vs, n) ->
                expect(len(vs), 3, "three items")
                expect(n.offset, 5, "consumed all five bytes")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_skip_ws() -> unit
        val p = skip_ws[string](literal("hi"))
        p(Input(as_bytes("   hi"), 0)) match
            Success(v, n) ->
                expect(n.offset, 5, "skipped 3 spaces and consumed 'hi'")
                if v != "hi" then panic(s"unexpected value: ${v}")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_lex_trailing_ws() -> unit
        val p = lex[string](literal("hi"))
        p(Input(as_bytes("hi   "), 0)) match
            Success(_, n) -> expect(n.offset, 5, "lex consumes trailing ws")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_parse_all_success() -> unit
        val p = literal("hi")
        parse_all[string](p, "  hi  ") match
            Success(v, _) ->
                if v != "hi" then panic(s"unexpected value: ${v}")
            Failure(m, _) -> panic(s"parse_all should succeed: ${m}")

    #test
    test_parse_all_trailing_garbage() -> unit
        val p = literal("hi")
        parse_all[string](p, "hi xx") match
            Success(_, _) -> panic("parse_all should have rejected trailing garbage")
            Failure(_, _) -> ()

    #test
    test_expr_atom() -> unit
        parse_all[int](expr(), "42") match
            Success(v, _) -> expect(v, 42, "single number")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_expr_add_sub_left_assoc() -> unit
        // 10 - 3 - 2 should be (10 - 3) - 2 = 5, not 10 - (3 - 2) = 9
        parse_all[int](expr(), "10 - 3 - 2") match
            Success(v, _) -> expect(v, 5, "left-assoc subtraction")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_expr_precedence() -> unit
        parse_all[int](expr(), "2 + 3 * 4") match
            Success(v, _) -> expect(v, 14, "* before +")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_expr_parens() -> unit
        parse_all[int](expr(), "(2 + 3) * 4") match
            Success(v, _) -> expect(v, 20, "parens override precedence")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_expr_nested_parens() -> unit
        parse_all[int](expr(), "((1 + 2) * (3 + 4))") match
            Success(v, _) -> expect(v, 21, "nested parens compute")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_expr_div_left_assoc() -> unit
        // 100 / 5 / 2 should be 20 / 2 = 10, not 100 / 2 = 50 (then / 5 = 10 — same answer)
        // pick numbers that diverge: 100 / 10 / 2 = 10 / 2 = 5, vs 100 / (10 / 2) = 100 / 5 = 20
        parse_all[int](expr(), "100 / 10 / 2") match
            Success(v, _) -> expect(v, 5, "left-assoc division")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_expr_whitespace_robust() -> unit
        parse_all[int](expr(), "  1+2 *  3  ") match
            Success(v, _) -> expect(v, 7, "tolerates arbitrary whitespace")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_expr_rejects_garbage() -> unit
        parse_all[int](expr(), "1 + abc") match
            Success(_, _) -> panic("should reject 'abc' as a factor")
            Failure(_, _) -> ()

    #test
    test_expr_unary_neg() -> unit
        parse_all[int](expr(), "-5") match
            Success(v, _) -> expect(v, -5, "unary minus on number")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_expr_unary_neg_in_add() -> unit
        // -2 + 3: unary minus binds tighter than the additive level
        parse_all[int](expr(), "-2 + 3") match
            Success(v, _) -> expect(v, 1, "-2 + 3 = 1")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_expr_binary_minus_then_unary() -> unit
        // 2--3: binary `-` followed by unary `-` on 3 (no spaces)
        parse_all[int](expr(), "2--3") match
            Success(v, _) -> expect(v, 5, "2--3 = 5")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_expr_unary_neg_paren() -> unit
        parse_all[int](expr(), "-(2 + 3)") match
            Success(v, _) -> expect(v, -5, "-(2 + 3) = -5")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_expr_double_neg() -> unit
        parse_all[int](expr(), "--5") match
            Success(v, _) -> expect(v, 5, "--5 = 5")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_eexpr_atom() -> unit
        parse_all[Expr](eexpr(), "42") match
            Success(t, _) -> expect(eval(t), 42, "atom AST evaluates")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_eexpr_precedence() -> unit
        parse_all[Expr](eexpr(), "2 + 3 * 4") match
            Success(t, _) ->
                // Tree should be Add(Num(2), Mul(Num(3), Num(4)))
                expect(eval(t), 14, "eval of (2 + 3*4) AST")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_eexpr_nested_parens() -> unit
        parse_all[Expr](eexpr(), "((1 + 2) * (3 + 4))") match
            Success(t, _) -> expect(eval(t), 21, "eval of nested-paren AST")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_eexpr_unary_neg() -> unit
        parse_all[Expr](eexpr(), "-(2 + 3)") match
            Success(t, _) -> expect(eval(t), -5, "eval of -(2+3) AST")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_eexpr_tree_shape() -> unit
        // Confirm the parser actually builds the right tree shape, not just
        // an equivalent value.
        parse_all[Expr](eexpr(), "1 - 2") match
            Success(t, _) ->
                t match
                    Sub(l, r) ->
                        expect(eval(l), 1, "left side evaluates to 1")
                        expect(eval(r), 2, "right side evaluates to 2")
                    _ -> panic("expected Sub at the top of the tree")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")
