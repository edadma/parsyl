parsyl — higher-order combinators
==================================

Combinators that take parsers and return new parsers — the "glue" layer
above the atom primitives in `atoms.lsysl` and the basic combinators in
`parsyl.lsysl` (`seq`, `or`, `rep`, `chainl1`, etc.). Lives alongside
the rest of the library under the same `module parsyl`.

Surface in this file:

  - `label(p, name)` — rewrite failure message.
  - `skip(p)` — discard the value, keep the cursor advance.
  - `between(open, close, p)` — alias for `open ~> p <~ close`.
  - `choice([p1, p2, ...])` — variadic alternation.
  - `count(n, p)` — exactly n repetitions.
  - `many_till(p, stop)` — repeat until stop matches; consumes stop.

    module parsyl

    import std.bytes.{as_bytes}


label
-----

`label(p, name)` rewrites the failure message of `p` to read like
"expected NAME". Useful for surfacing meaningful diagnostics from
deep within a grammar.

    label[A](p: Parser[A], name: string) -> Parser[A] =
        Parser[A]((inp: Input) ->
            p(inp) match
                Success(v, n) -> Success(v, n)
                Failure(_, n) -> Failure(s"expected ${name}", n))


skip
----

`skip(p)` runs `p` for its side effect (cursor advance) and discards
the value.

    skip[A](p: Parser[A]) -> Parser[unit] =
        p ^^ ((_: A) -> ())


between
-------

`between(open, close, p)` runs `open` then `p` then `close`, returning
only `p`'s value. Equivalent to `open ~> p <~ close` but reads linearly
when the delimiters are simple parsers passed positionally.

    between[O, C, A](open: Parser[O], close: Parser[C], p: Parser[A]) -> Parser[A] =
        seq_l(seq_r(open, p), close)


choice
------

`choice([p1, p2, ...])` is variadic alternation — useful when there are
many alternatives and the chained `|` form gets noisy. Folds the slice
through `or` at construction time, so the runtime path is identical to
hand-written `p1 | p2 | p3`.

    choice[A](ps: []Parser[A]) -> Parser[A] =
        if len(ps) == 0 then failure[A]("empty choice")
        else
            var combined = ps[0]
            var i = 1
            while i < len(ps) do
                combined = or(combined, ps[i])
                i = i + 1
            combined


count
-----

`count(n, p)` runs `p` exactly `n` times, returning the collected
values. Fails on the k-th repetition if `p` does. Useful for
fixed-width fields, hex-byte runs, IPv4 octets, etc.

    count[A](n: int, p: Parser[A]) -> Parser[[]A] =
        Parser[[]A]((inp: Input) ->
            var result: []A = []
            var current = inp
            var i = 0
            var failed = false
            var fail_msg = ""
            var fail_at = inp
            while i < n && !failed do
                p(current) match
                    Success(v, after) ->
                        result = append(result, v)
                        current = after
                    Failure(m, at) ->
                        failed = true
                        fail_msg = m
                        fail_at = at
                i = i + 1
            if failed then Failure(fail_msg, fail_at)
            else Success(result, current))


many_till
---------

`many_till(p, stop)` repeats `p` until `stop` matches, returning the
values collected. Consumes the matched `stop` (it's a delimiter, not
part of the content). Classic use case: C-style block-comment bodies —
`many_till(any_char, "*/")` collects everything up to and including
the closing delimiter.

    many_till[A, B](p: Parser[A], stop: Parser[B]) -> Parser[[]A] =
        Parser[[]A]((inp: Input) ->
            var result: []A = []
            var current = inp
            var done = false
            var failed = false
            var fail_msg = ""
            var fail_at = inp
            while !done && !failed do
                stop(current) match
                    Success(_, after) ->
                        done = true
                        current = after
                    Failure(_, _) ->
                        p(current) match
                            Success(v, after) ->
                                result = append(result, v)
                                current = after
                            Failure(m, at) ->
                                failed = true
                                fail_msg = m
                                fail_at = at
            if failed then Failure(fail_msg, fail_at)
            else Success(result, current))
Combinator tests
----------------

    #test
    test_between_strips_delimiters() -> unit
        val p = between(literal("("), literal(")"), literal("x"))
        p(Input(as_bytes("(x)"), 0)) match
            Success(v, n) ->
                if v != "x" then panic(s"expected 'x', got '${v}'")
                expect(n.offset, 3, "between consumed all 3 bytes")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_between_fails_on_missing_close() -> unit
        val p = between(literal("("), literal(")"), literal("x"))
        p(Input(as_bytes("(x"), 0)) match
            Success(_, _) -> panic("should have failed on missing ')'")
            Failure(_, _) -> ()

    #test
    test_chr_matches() -> unit
        val p = chr('q')
        p(Input(as_bytes("q"), 0)) match
            Success(c, n) ->
                if c != 'q' then panic(s"got '${c}'")
                expect(n.offset, 1, "chr advances by 1")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_chr_rejects_other() -> unit
        val p = chr('q')
        p(Input(as_bytes("Q"), 0)) match
            Success(_, _) -> panic("chr 'q' should reject 'Q' (case-sensitive)")
            Failure(_, _) -> ()

    #test
    test_one_of_matches() -> unit
        val p = one_of("aeiou")
        p(Input(as_bytes("e"), 0)) match
            Success(c, _) -> if c != 'e' then panic(s"got '${c}'")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_one_of_rejects() -> unit
        val p = one_of("aeiou")
        p(Input(as_bytes("z"), 0)) match
            Success(_, _) -> panic("one_of vowels should reject 'z'")
            Failure(_, _) -> ()

    #test
    test_none_of_matches_outside_set() -> unit
        val p = none_of("aeiou")
        p(Input(as_bytes("z"), 0)) match
            Success(c, _) -> if c != 'z' then panic(s"got '${c}'")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_none_of_rejects_inside_set() -> unit
        val p = none_of("aeiou")
        p(Input(as_bytes("e"), 0)) match
            Success(_, _) -> panic("none_of vowels should reject 'e'")
            Failure(_, _) -> ()

    #test
    test_choice_picks_first_match() -> unit
        val p = choice[string]([literal("foo"), literal("bar"), literal("baz")])
        p(Input(as_bytes("baz"), 0)) match
            Success(v, _) -> if v != "baz" then panic(s"got '${v}'")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_choice_fails_when_none_match() -> unit
        val p = choice[string]([literal("a"), literal("b"), literal("c")])
        p(Input(as_bytes("z"), 0)) match
            Success(_, _) -> panic("choice should fail on 'z'")
            Failure(_, _) -> ()

    #test
    test_choice_empty_always_fails() -> unit
        val empty: []Parser[string] = []
        val p = choice[string](empty)
        p(Input(as_bytes("anything"), 0)) match
            Success(_, _) -> panic("empty choice should always fail")
            Failure(_, _) -> ()

    #test
    test_take_while_consumes_run() -> unit
        val p = take_while((c: char) -> '0' <= c <= '9')
        p(Input(as_bytes("123abc"), 0)) match
            Success(v, n) ->
                if v != "123" then panic(s"expected '123', got '${v}'")
                expect(n.offset, 3, "take_while advanced past digits")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_take_while_empty_match_succeeds() -> unit
        val p = take_while((c: char) -> '0' <= c <= '9')
        p(Input(as_bytes("abc"), 0)) match
            Success(v, n) ->
                if v != "" then panic(s"expected empty, got '${v}'")
                expect(n.offset, 0, "take_while no advance on empty match")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_count_exact() -> unit
        val p = count[char](3, digit())
        p(Input(as_bytes("12345"), 0)) match
            Success(v, n) ->
                if len(v) != 3 then panic(s"expected 3 elements, got ${len(v)}")
                if v[0] != '1' || v[1] != '2' || v[2] != '3' then
                    panic("wrong digits collected")
                expect(n.offset, 3, "count advances exactly 3")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_count_fails_short() -> unit
        val p = count[char](4, digit())
        p(Input(as_bytes("12x"), 0)) match
            Success(_, _) -> panic("count(4, digit) should fail on '12x'")
            Failure(_, _) -> ()

    #test
    test_count_zero_succeeds_empty() -> unit
        val p = count[char](0, digit())
        p(Input(as_bytes("abc"), 0)) match
            Success(v, n) ->
                if len(v) != 0 then panic("count(0) should yield empty")
                expect(n.offset, 0, "count(0) does not advance")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_many_till_collects_until_end() -> unit
        // C-style block-comment body: any char until "*/"
        val any_char = accept_if("any", (_: char) -> true)
        val p = many_till(any_char, literal("*/"))
        p(Input(as_bytes("hello*/rest"), 0)) match
            Success(cs, n) ->
                if len(cs) != 5 then panic(s"expected 5 chars, got ${len(cs)}")
                expect(n.offset, 7, "many_till consumes the end delimiter")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_many_till_empty_when_end_matches_first() -> unit
        val any_char = accept_if("any", (_: char) -> true)
        val p = many_till(any_char, literal("X"))
        p(Input(as_bytes("Xrest"), 0)) match
            Success(cs, n) ->
                if len(cs) != 0 then panic("many_till should yield empty")
                expect(n.offset, 1, "many_till consumed only the delimiter")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_many_till_fails_when_neither_matches() -> unit
        val any_char = accept_if("any", (c: char) -> c == 'a')
        val p = many_till(any_char, literal("END"))
        p(Input(as_bytes("aabZ"), 0)) match
            Success(_, _) -> panic("many_till should fail when content parser fails before end")
            Failure(_, _) -> ()


