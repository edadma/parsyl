    #test
    test_chainl1() -> unit
        // smoke test: exercise the no-iteration path. `success[int](42)` consumes no
        // input but the op (`failure`) fails immediately, so chainl1 returns the
        // single operand. Using a non-failing op here would loop forever — both
        // operand and op succeed without consuming input.
        val no_op: Parser[(int, int) -> int] = failure[(int, int) -> int]("no op")
        val one_only: Parser[int] = chainl1(success[int](42), no_op)
        one_only(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 42, "chainl1 with no ops returns the operand")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_chainr1_no_op() -> unit
        // same shape as test_chainl1: no-iteration path, op fails immediately.
        val no_op: Parser[(int, int) -> int] = failure[(int, int) -> int]("no op")
        val one_only: Parser[int] = chainr1(success[int](42), no_op)
        one_only(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 42, "chainr1 with no ops returns the operand")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_lazy_p() -> unit
        // thunk evaluates lazily on each call; the underlying parser is just success(7).
        val p: Parser[int] = lazy_p[int](() -> success[int](7))
        p(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 7, "lazy_p delegates to thunked parser")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

