            Success(v, _) -> expect(v, 7, "hex_digit '7' = 7")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_hex_digit_rejects_g() -> unit
        val p = hex_digit()
        p(Input(as_bytes("g"), 0)) match
            Success(_, _) -> panic("hex_digit should reject 'g'")
            Failure(_, _) -> ()

    #test
    test_label_replaces_msg() -> unit
        val p = label(literal("foo"), "the foo keyword")
        p(Input(as_bytes("bar"), 0)) match
            Success(_, _) -> panic("should fail on 'bar'")
            Failure(m, _) ->
                if m != "expected the foo keyword" then
                    panic(s"unexpected msg: ${m}")

    #test
    test_label_passes_through_success() -> unit
        val p = label(literal("foo"), "the foo keyword")
        p(Input(as_bytes("foo"), 0)) match
            Success(v, _) -> if v != "foo" then panic("expected 'foo'")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_skip_discards() -> unit
        val p = skip(literal("hello"))
        p(Input(as_bytes("hello!"), 0)) match
            Success(_, n) -> expect(n.offset, 5, "skip advanced past 'hello'")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_pos_of_first_line() -> unit
        val inp = Input(as_bytes("hello"), 3)
        val (line, col) = pos_of(inp)
        expect(line, 1, "first line")
        expect(col, 4, "col 4 (1-indexed, after 'hel')")

    #test
    test_pos_of_after_newline() -> unit
        // "ab\ncd\nef" — offset 6 lands on 'e' on line 3
        val inp = Input(as_bytes("ab\ncd\nef"), 6)
        val (line, col) = pos_of(inp)
        expect(line, 3, "third line after two newlines")
        expect(col, 1, "col 1 at start of line")

    #test
    test_pos_of_at_start() -> unit
        val inp = Input(as_bytes("anything"), 0)
        val (line, col) = pos_of(inp)
        expect(line, 1, "line 1 at start")
        expect(col, 1, "col 1 at start")

    #test
    test_format_failure_single_line() -> unit
        val at = Input(as_bytes("xyz abc"), 4)
        val out = format_failure("expected number", at)
        // "line 1, col 5: expected number\nxyz abc\n    ^"
        if out != "line 1, col 5: expected number\nxyz abc\n    ^" then
            panic(s"unexpected format: ${out}")

    #test
    test_format_failure_multi_line() -> unit
        // Source has two lines; failure on the second.
        val at = Input(as_bytes("first\nsecond"), 9)
        val out = format_failure("oops", at)
        // line 2, col 4 → cursor at 'o' of "second"
        if out != "line 2, col 4: oops\nsecond\n   ^" then
            panic(s"unexpected format: ${out}")


Combinator tests
----------------

    #test
    test_between_strips_delimiters() -> unit
        val p = between(literal("("), literal(")"), literal("x"))
        p(Input(as_bytes("(x)"), 0)) match
            Success(v, n) ->
                if v != "x" then panic(s"expected 'x', got '${v}'")
                expect(n.offset, 3, "between consumed all 3 bytes")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_between_fails_on_missing_close() -> unit
        val p = between(literal("("), literal(")"), literal("x"))
        p(Input(as_bytes("(x"), 0)) match
            Success(_, _) -> panic("should have failed on missing ')'")
            Failure(_, _) -> ()

    #test
    test_chr_matches() -> unit
        val p = chr('q')
        p(Input(as_bytes("q"), 0)) match
            Success(c, n) ->
                if c != 'q' then panic(s"got '${c}'")
                expect(n.offset, 1, "chr advances by 1")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_chr_rejects_other() -> unit
        val p = chr('q')
        p(Input(as_bytes("Q"), 0)) match
            Success(_, _) -> panic("chr 'q' should reject 'Q' (case-sensitive)")
            Failure(_, _) -> ()

    #test
    test_one_of_matches() -> unit
        val p = one_of("aeiou")
        p(Input(as_bytes("e"), 0)) match
            Success(c, _) -> if c != 'e' then panic(s"got '${c}'")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_one_of_rejects() -> unit
        val p = one_of("aeiou")
        p(Input(as_bytes("z"), 0)) match
            Success(_, _) -> panic("one_of vowels should reject 'z'")
            Failure(_, _) -> ()

    #test
    test_none_of_matches_outside_set() -> unit
        val p = none_of("aeiou")
        p(Input(as_bytes("z"), 0)) match
            Success(c, _) -> if c != 'z' then panic(s"got '${c}'")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_none_of_rejects_inside_set() -> unit
        val p = none_of("aeiou")
        p(Input(as_bytes("e"), 0)) match
            Success(_, _) -> panic("none_of vowels should reject 'e'")
            Failure(_, _) -> ()

    #test
    test_choice_picks_first_match() -> unit
        val p = choice[string]([literal("foo"), literal("bar"), literal("baz")])
        p(Input(as_bytes("baz"), 0)) match
            Success(v, _) -> if v != "baz" then panic(s"got '${v}'")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_choice_fails_when_none_match() -> unit
        val p = choice[string]([literal("a"), literal("b"), literal("c")])
        p(Input(as_bytes("z"), 0)) match
            Success(_, _) -> panic("choice should fail on 'z'")
            Failure(_, _) -> ()

    #test
    test_choice_empty_always_fails() -> unit
        val empty: []Parser[string] = []
        val p = choice[string](empty)
        p(Input(as_bytes("anything"), 0)) match
            Success(_, _) -> panic("empty choice should always fail")
            Failure(_, _) -> ()

    #test
    test_take_while_consumes_run() -> unit
        val p = take_while((c: char) -> '0' <= c <= '9')
        p(Input(as_bytes("123abc"), 0)) match
            Success(v, n) ->
                if v != "123" then panic(s"expected '123', got '${v}'")
                expect(n.offset, 3, "take_while advanced past digits")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_take_while_empty_match_succeeds() -> unit
        val p = take_while((c: char) -> '0' <= c <= '9')
        p(Input(as_bytes("abc"), 0)) match
            Success(v, n) ->
                if v != "" then panic(s"expected empty, got '${v}'")
                expect(n.offset, 0, "take_while no advance on empty match")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_count_exact() -> unit
        val p = count[char](3, digit())
        p(Input(as_bytes("12345"), 0)) match
            Success(v, n) ->
                if len(v) != 3 then panic(s"expected 3 elements, got ${len(v)}")
                if v[0] != '1' || v[1] != '2' || v[2] != '3' then
                    panic("wrong digits collected")
                expect(n.offset, 3, "count advances exactly 3")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_count_fails_short() -> unit
        val p = count[char](4, digit())
        p(Input(as_bytes("12x"), 0)) match
            Success(_, _) -> panic("count(4, digit) should fail on '12x'")
            Failure(_, _) -> ()

    #test
    test_count_zero_succeeds_empty() -> unit
        val p = count[char](0, digit())
        p(Input(as_bytes("abc"), 0)) match
            Success(v, n) ->
                if len(v) != 0 then panic("count(0) should yield empty")
                expect(n.offset, 0, "count(0) does not advance")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_many_till_collects_until_end() -> unit
        // C-style block-comment body: any char until "*/"
        val any_char = accept_if("any", (_: char) -> true)
        val p = many_till(any_char, literal("*/"))
        p(Input(as_bytes("hello*/rest"), 0)) match
            Success(cs, n) ->
                if len(cs) != 5 then panic(s"expected 5 chars, got ${len(cs)}")
                expect(n.offset, 7, "many_till consumes the end delimiter")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_many_till_empty_when_end_matches_first() -> unit
        val any_char = accept_if("any", (_: char) -> true)
        val p = many_till(any_char, literal("X"))
        p(Input(as_bytes("Xrest"), 0)) match
            Success(cs, n) ->
                if len(cs) != 0 then panic("many_till should yield empty")
                expect(n.offset, 1, "many_till consumed only the delimiter")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_many_till_fails_when_neither_matches() -> unit
        val any_char = accept_if("any", (c: char) -> c == 'a')
        val p = many_till(any_char, literal("END"))
        p(Input(as_bytes("aabZ"), 0)) match
            Success(_, _) -> panic("many_till should fail when content parser fails before end")
            Failure(_, _) -> ()


Regex tests
-----------

    #test
    test_regex_digits_match() -> unit
        val p = regex("[0-9]+")
        p(Input(as_bytes("123abc"), 0)) match
            Success(v, n) ->
                if v != "123" then panic(s"expected '123', got '${v}'")
                expect(n.offset, 3, "advanced past digits")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_regex_must_match_at_cursor() -> unit
        // regex anchors at cursor: 'abc123' must NOT match [0-9]+ at offset 0
        val p = regex("[0-9]+")
        p(Input(as_bytes("abc123"), 0)) match
            Success(v, _) -> panic(s"should not match anywhere; got '${v}'")
            Failure(_, _) -> ()

    #test
    test_regex_advances_correctly() -> unit
        // After regex consumes 'foo', a following literal must see 'bar'
        val p = regex("f[a-z]+") ~ literal("!")
        p(Input(as_bytes("foo!"), 0)) match
            Success(t, n) ->
                if t._0 != "foo" then panic(s"expected 'foo', got '${t._0}'")
                if t._1 != "!" then panic(s"expected '!', got '${t._1}'")
                expect(n.offset, 4, "advanced 4 bytes")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_regex_leftmost_longest() -> unit
        // Within a match anchored at cursor, POSIX leftmost-longest applies
        val p = regex("a+")
        p(Input(as_bytes("aaaab"), 0)) match
            Success(v, n) ->
                if v != "aaaa" then panic(s"expected 'aaaa', got '${v}'")
                expect(n.offset, 4, "consumed all 4 a's")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_regex_with_lex() -> unit
        // lex(regex(...)) is the canonical "skip ws, match, skip ws" idiom
        val p = lex(regex("[A-Za-z]+"))
        parse_all[string](p, "   hello   ") match
            Success(v, _) -> if v != "hello" then panic(s"expected 'hello', got '${v}'")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_regex_alternation_anchored_first() -> unit
        // 'red|blue' against 'redball' — anchored match returns 'red'
        val p = regex("red|blue")
        p(Input(as_bytes("redball"), 0)) match
            Success(v, n) ->
                if v != "red" then panic(s"expected 'red', got '${v}'")
                expect(n.offset, 3, "advanced 3 bytes")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_regex_empty_match_advances_zero() -> unit
        // '[0-9]*' matches empty at any position
        val p = regex("[0-9]*")
        p(Input(as_bytes("abc"), 0)) match
            Success(v, n) ->
                if v != "" then panic(s"expected '', got '${v}'")
                expect(n.offset, 0, "no advance for empty match")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_regex_in_grammar() -> unit
        // Toy use: 'word=value' where word and value are alphanumeric runs
        val word = regex("[a-z]+")
        val p = lex(word) ~ lex(literal("=")) ~ lex(word) ^^
            ((t: ((string, string), string)) -> s"${t._0._0}=${t._1}")
        parse_all[string](p, "  foo  =  bar  ") match
            Success(v, _) -> if v != "foo=bar" then panic(s"got '${v}'")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_r_alias() -> unit
        // `r("pat")` is the short alias — composes via the existing
        // Parser[string] operator overloads exactly like `regex(pat)`.
        val p = lex(r("[a-z]+")) ~ "=" ~ lex(r("[0-9]+")) ^^
            ((t: ((string, string), string)) -> s"${t._0._0}=${t._1}")
        parse_all[string](p, "x = 42") match
            Success(v, _) -> if v != "x=42" then panic(s"got '${v}'")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_string_r_extension() -> unit
        // The Scala-parity form: `"pattern".r` as a parameterless
        // extension method on string. Reads identically to
        // `RegexParsers`' `"\\d+".r ~ "=" ~ "[a-z]+".r`.
        val p = lex("[a-z]+".r) ~ "=" ~ lex("[0-9]+".r) ^^
            ((t: ((string, string), string)) -> s"${t._0._0}=${t._1}")
        parse_all[string](p, "abc = 7") match
            Success(v, _) -> if v != "abc=7" then panic(s"got '${v}'")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")
