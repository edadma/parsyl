parsyl — combinator parser library
===================================

The first sysl-native parser combinator library. Provides the usual
core combinators plus operator sugar (`~`, `|`, `~>`, `<~`, `^^`,
`^^^`, plus PEG-style `!p` / `&p`) and bare-string operand lifting,
so grammars read like the canonical Scala parser-combinator idiom.

    module parsyl

    import std.option.{Option, Some, None}
    import std.bytes.{as_bytes, has_prefix}
    import std.utf8.{decode_rune}
    import std.builder.{new_builder}
    import std.regex.*
    import std.debug.{assert}
    import std.strconv.{parse_int}
    import std.result.{unwrap}


Input
-----

    struct Input
        source: []byte
        offset: int

    Input.at_end() -> bool = self.offset >= len(self.source)
    Input.advance(n: int) -> Input = Input(self.source, self.offset + n)

`mk_input(s)` is the conversational entry point — converts a string to
the byte-slice-backed `Input` once at the boundary. Past that, all
parser combinators work in bytes (zero-copy slicing, UTF-8 decoding via
`std.utf8`).

    mk_input(s: string) -> Input = Input(as_bytes(s), 0)


ParseResult
-----------

    enum ParseResult[A]
        Success(value: A, next: Input)
        Failure(msg: string, at: Input)


Parser
------

    type Parser[A] = new (Input) -> ParseResult[A]


Trivial parsers
---------------

    success[A](v: A) -> Parser[A] =
        Parser[A]((inp: Input) -> Success(v, inp))

    failure[A](msg: string) -> Parser[A] =
        Parser[A]((inp: Input) -> Failure(msg, inp))


eoi
---

    eoi -> Parser[unit] =
        Parser[unit]((inp: Input) ->
            if inp.at_end() then Success((), inp)
            else Failure("expected end of input", inp))


map
---

    map[A, B](p: Parser[A], f: (A) -> B) -> Parser[B] =
        Parser[B]((inp: Input) ->
            p(inp) match
                Success(v, n) -> Success(f(v), n)
                Failure(m, n) -> Failure(m, n))


seq
---

`seq` runs `p` then `q`, returning the pair. `seq_l` and `seq_r` are the
"keep left" / "keep right" variants — used heavily for skipping
delimiters.

    seq[A, B](p: Parser[A], q: Parser[B]) -> Parser[(A, B)] =
        Parser[(A, B)]((inp: Input) ->
            p(inp) match
                Failure(m, n) -> Failure(m, n)
                Success(va, na) ->
                    q(na) match
                        Failure(m, n) -> Failure(m, n)
                        Success(vb, nb) -> Success((va, vb), nb))

    seq_l[A, B](p: Parser[A], q: Parser[B]) -> Parser[A] =
        p ~ q ^^ ((t: (A, B)) -> t._0)

    seq_r[A, B](p: Parser[A], q: Parser[B]) -> Parser[B] =
        p ~ q ^^ ((t: (A, B)) -> t._1)


flat_map
--------

    flat_map[A, B](p: Parser[A], f: (A) -> Parser[B]) -> Parser[B] =
        Parser[B]((inp: Input) ->
            p(inp) match
                Success(v, n) -> f(v)(n)
                Failure(m, n) -> Failure(m, n))


or
--

    or[A](p: Parser[A], q: Parser[A]) -> Parser[A] =
        Parser[A]((inp: Input) ->
            p(inp) match
                Success(v, n) -> Success(v, n)
                Failure(_, _) -> q(inp))


opt
---

    opt[A](p: Parser[A]) -> Parser[Option[A]] =
        Parser[Option[A]]((inp: Input) ->
            p(inp) match
                Success(v, n) -> Success(Some(v), n)
                Failure(_, _) -> Success(None, inp))


not_p, and_p — PEG-style lookahead
----------------------------------

`not_p(p)` is the negative-lookahead predicate: succeeds with `()` if
`p` would *fail* at the current position, fails if `p` would succeed.
Either way the cursor doesn't advance — the predicate just *guards*
what comes next.

`and_p(p)` is the positive-lookahead predicate: succeeds with `p`'s
value if `p` would succeed at the current position, fails otherwise.
Again, the cursor doesn't advance.

Together they express PEG-style guards naturally:
`&letter ~> rep1(alphanum)` to require the run starts with a letter,
or `!reserved ~> ident` to reject reserved words.

The `!` and `&` sugar dispatches to the function form via dedicated
traits — `!` and `&` overload the built-in prefix sigils (which keep
their `!bool` / `&lvalue` semantics on those types and only delegate
to user impls for other operand types).

    not_p[A](p: Parser[A]) -> Parser[unit] =
        Parser[unit]((inp: Input) ->
            p(inp) match
                Success(_, _) -> Failure("not-predicate matched", inp)
                Failure(_, _) -> Success((), inp))

    and_p[A](p: Parser[A]) -> Parser[A] =
        Parser[A]((inp: Input) ->
            p(inp) match
                Success(v, _) -> Success(v, inp)
                Failure(m, n) -> Failure(m, n))

    trait Not[A, R]
        #operator("!")
        not_op(a: A) -> R

    impl[A] Not[Parser[A], Parser[unit]]
        not_op(p: Parser[A]) -> Parser[unit] = not_p(p)

    trait Peek[A, R]
        #operator("&")
        peek_op(a: A) -> R

    impl[A] Peek[Parser[A], Parser[A]]
        peek_op(p: Parser[A]) -> Parser[A] = and_p(p)

Bare-string operands lift to `lex(literal(s))` here too, so a
grammar can write `&"ab"` and `!"c"` directly without spelling
`literal`. The lifted parser parses the string token (with
surrounding whitespace), so `!"c"` reads as "must not be the
literal token 'c' next".

    impl Not[string, Parser[unit]]
        not_op(s: string) -> Parser[unit] = not_p(lex(literal(s)))

    impl Peek[string, Parser[string]]
        peek_op(s: string) -> Parser[string] = and_p(lex(literal(s)))


rep
---

Zero or more applications of `p`. The no-progress check
(`n.offset > current.offset`) defends against a parser that succeeds
without consuming input, which would otherwise loop forever.

    rep[A](p: Parser[A]) -> Parser[[]A] =
        Parser[[]A]((inp: Input) ->
            var result: []A = []
            var current = inp
            var more = true
            while more do
                p(current) match
                    Success(v, n) ->
                        if n.offset > current.offset then
                            result = append(result, v)
                            current = n
                        else
                            more = false
                    Failure(_, _) -> more = false
            Success(result, current))


rep1
----

One or more applications of `p`.

    rep1[A](p: Parser[A]) -> Parser[[]A] =
        Parser[[]A]((inp: Input) ->
            p(inp) match
                Failure(m, n) -> Failure(m, n)
                Success(first, after) ->
                    var result: []A = [first]
                    var current = after
                    var more = true
                    while more do
                        p(current) match
                            Success(v, n) ->
                                if n.offset > current.offset then
                                    result = append(result, v)
                                    current = n
                                else
                                    more = false
                            Failure(_, _) -> more = false
                    Success(result, current))


chainl1
-------

Left-associative fold. `operand` parses a single value; `op` parses a
binary combiner. `a OP b OP c` becomes `(a OP b) OP c`.

    chainl1[A](operand: Parser[A], op: Parser[(A, A) -> A]) -> Parser[A] =
        Parser[A]((inp: Input) ->
            operand(inp) match
                Failure(m, n) -> Failure(m, n)
                Success(first, after) ->
                    var acc = first
                    var current = after
                    var more = true
                    while more do
                        op(current) match
                            Failure(_, _) -> more = false
                            Success(f, n1) ->
                                operand(n1) match
                                    Failure(_, _) -> more = false
                                    Success(v, n2) ->
                                        acc = f(acc, v)
                                        current = n2
                    Success(acc, current))


Operators
---------

Combinator-style infix operators via the user-defined-operator and
multi-param-trait machinery. `~` for sequence, `|` for alternation,
`~>` and `<~` for sequence-keep-right / sequence-keep-left, `^^` for
map, `^^^` for replace-with-constant.

    trait Concat[A, B, R]
        #operator("~")
        concat(a: A, b: B) -> R

    impl[A, B] Concat[Parser[A], Parser[B], Parser[(A, B)]]
        concat(a: Parser[A], b: Parser[B]) -> Parser[(A, B)] = seq(a, b)

    trait Or[T]
        #operator("|")
        or_op(a: T, b: T) -> T

    impl[A] Or[Parser[A]]
        or_op(a: Parser[A], b: Parser[A]) -> Parser[A] = or(a, b)

    trait SeqR[A, B, R]
        #operator("~>")
        seqr(a: A, b: => B) -> R

    impl[A, B] SeqR[Parser[A], Parser[B], Parser[B]]
        seqr(a: Parser[A], b: => Parser[B]) -> Parser[B] =
            Parser[B]((inp: Input) ->
                a(inp) match
                    Failure(m, n) -> Failure(m, n)
                    Success(_, na) -> b(na))

    trait SeqL[A, B, R]
        #operator("<~")
        seql(a: A, b: => B) -> R

    impl[A, B] SeqL[Parser[A], Parser[B], Parser[A]]
        seql(a: Parser[A], b: => Parser[B]) -> Parser[A] =
            Parser[A]((inp: Input) ->
                a(inp) match
                    Failure(m, n) -> Failure(m, n)
                    Success(va, na) ->
                        b(na) match
                            Failure(m, n) -> Failure(m, n)
                            Success(_, nb) -> Success(va, nb))

    trait Map[A, F, R]
        #operator("^^")
        pmap(a: A, f: F) -> R

    impl[A, B] Map[Parser[A], (A) -> B, Parser[B]]
        pmap(a: Parser[A], f: (A) -> B) -> Parser[B] = map(a, f)

    trait MapTo[A, V, R]
        #operator("^^^")
        pmapto(a: A, v: V) -> R

    impl[A, B] MapTo[Parser[A], B, Parser[B]]
        pmapto(a: Parser[A], v: B) -> Parser[B] = map(a, (_: A) -> v)

    impl[B] MapTo[string, B, Parser[B]]
        pmapto(s: string, v: B) -> Parser[B] = map(lex(literal(s)), (_: string) -> v)

    impl[B] Map[string, (string) -> B, Parser[B]]
        pmap(s: string, f: (string) -> B) -> Parser[B] = map(lex(literal(s)), f)

A string literal in operator position lifts itself to `lex(literal(s))`
— skips surrounding whitespace and matches the token. Lets grammars
read like the Scala parser-combinator idiom: `"(" ~> expr <~ ")"`.

    impl[B] Concat[string, Parser[B], Parser[(string, B)]]
        concat(s: string, b: Parser[B]) -> Parser[(string, B)] = seq(lex(literal(s)), b)

    impl[A] Concat[Parser[A], string, Parser[(A, string)]]
        concat(a: Parser[A], s: string) -> Parser[(A, string)] = seq(a, lex(literal(s)))

    impl[B] SeqR[string, Parser[B], Parser[B]]
        seqr(s: string, b: => Parser[B]) -> Parser[B] =
            val sp = lex(literal(s))
            Parser[B]((inp: Input) ->
                sp(inp) match
                    Failure(m, n) -> Failure(m, n)
                    Success(_, na) -> b(na))

    impl[A] SeqR[Parser[A], string, Parser[string]]
        seqr(a: Parser[A], s: => string) -> Parser[string] = seq_r(a, lex(literal(s)))

    impl[B] SeqL[string, Parser[B], Parser[string]]
        seql(s: string, b: => Parser[B]) -> Parser[string] =
            val sp = lex(literal(s))
            Parser[string]((inp: Input) ->
                sp(inp) match
                    Failure(m, n) -> Failure(m, n)
                    Success(va, na) ->
                        b(na) match
                            Failure(m, n) -> Failure(m, n)
                            Success(_, nb) -> Success(va, nb))

    impl[A] SeqL[Parser[A], string, Parser[A]]
        seql(a: Parser[A], s: => string) -> Parser[A] = seq_l(a, lex(literal(s)))


chainr1
-------

Right-associative fold. `a OP b OP c` becomes `a OP (b OP c)`.

    chainr1[A](operand: Parser[A], op: Parser[(A, A) -> A]) -> Parser[A] =
        Parser[A]((inp: Input) ->
            operand(inp) match
                Failure(m, n) -> Failure(m, n)
                Success(first, after) ->
                    var values: []A = [first]
                    var ops: [](A, A) -> A = []
                    var current = after
                    var more = true
                    while more do
                        op(current) match
                            Failure(_, _) -> more = false
                            Success(f, n1) ->
                                operand(n1) match
                                    Failure(_, _) -> more = false
                                    Success(v, n2) ->
                                        ops = append(ops, f)
                                        values = append(values, v)
                                        current = n2
                    var acc = values[len(values) - 1]
                    var i = len(values) - 2
                    while i >= 0 do
                        acc = ops[i](values[i], acc)
                        i = i - 1
                    Success(acc, current))


lazy_p
------

Defer parser construction until invocation. For non-left-recursive
grammars where wrapping the body in a closure would be awkward.

    lazy_p[A](thunk: () -> Parser[A]) -> Parser[A] =
        Parser[A]((inp: Input) -> thunk()(inp))


repsep / rep1sep
----------------

`p` separated by `sep`. `repsep` allows zero matches; `rep1sep` requires
at least one. The trailing-sep case (sep succeeds but `p` fails) is
treated as a hard failure — we'd already committed to the separator.

    rep1sep[A, S](p: Parser[A], sep: Parser[S]) -> Parser[[]A] =
        Parser[[]A]((inp: Input) ->
            p(inp) match
                Failure(m, n) -> Failure(m, n)
                Success(first, after) ->
                    var result: []A = [first]
                    var current = after
                    var status: ParseResult[[]A] = Success(result, current)
                    var more = true
                    while more do
                        sep(current) match
                            Failure(_, _) ->
                                status = Success(result, current)
                                more = false
                            Success(_, n1) ->
                                p(n1) match
                                    Failure(m, n) ->
                                        status = Failure(m, n)
                                        more = false
                                    Success(v, n2) ->
                                        result = append(result, v)
                                        current = n2
                    status)

    repsep[A, S](p: Parser[A], sep: Parser[S]) -> Parser[[]A] =
        rep1sep(p, sep) | success[[]A]([])


accept_if
---------

Read one byte if it satisfies the predicate. `label` is woven into the
failure message — pass something the user can act on like `"digit"` or
`"alpha"`.

    accept_if(label: string, pred: (char) -> bool) -> Parser[char] =
        Parser[char]((inp: Input) ->
            if inp.at_end() then
                Failure(s"expected ${label}, got end of input", inp)
            else
                val (c, n) = decode_rune(inp.source[inp.offset : len(inp.source)])
                if pred(c) then Success(c, inp.advance(n))
                else Failure(s"expected ${label}", inp))


literal
-------

Match a literal string prefix. Uses `std.strings.has_prefix` over the
unconsumed slice — empty string matches at every position.

    literal(s: string) -> Parser[string] =
        val sb = as_bytes(s)
        Parser[string]((inp: Input) ->
            val rest = inp.source[inp.offset : len(inp.source)]
            if has_prefix(rest, sb) then
                Success(s, inp.advance(len(sb)))
            else
                Failure(s"expected literal '${s}'", inp))


regex
-----

Match a POSIX regular expression at the current cursor position. The
pattern is parsed and compiled to bytecode once, at parser construction;
the returned `Parser[string]` reuses the same bytecode on every call.

Anchoring: the regex must match starting at the current cursor — even if
the pattern itself is unanchored. We achieve this by running the engine
on the unconsumed slice and rejecting any match whose start offset is
nonzero. (POSIX leftmost-longest semantics still apply within the match
that starts at zero.) Use `^...` / `...$` inside the pattern only to
constrain start-of-source / end-of-source if you want those.

The Scala parser-combinator analogue is `regex(r: Regex): Parser[String]`
from `RegexParsers`. Wrap with `lex(...)` for the typical "skip
whitespace, then match" form.

    regex(pattern: string) -> Parser[string] =
        val (root, nodes, classes, n_groups, err, msg, _) = parse_regex(pattern)
        assert(!err, s"invalid regex /${pattern}/: ${msg}")
        val insts = compile(root, nodes, n_groups)
        Parser[string]((inp: Input) ->
            val rest = string(inp.source[inp.offset : len(inp.source)])
            val m = exec(insts, classes, rest, n_groups)
            if m.matched() && m.starts[0] == 0 then
                val n = m.ends[0]
                Success(string(inp.source[inp.offset : inp.offset + n]), inp.advance(n))
            else
                Failure(s"expected match for /${pattern}/", inp))

`r(pattern)` is a short-name free-function alias for `regex(pattern)`,
useful when the pattern lives in a variable: `r(my_pat) ~ "=" ~ r(my_pat)`.

    r(pattern: string) -> Parser[string] = regex(pattern)

`string.r` is the extension-method form, producing the *exact* Scala
parser-combinator surface — `"\\d+".r ~ "=" ~ "[a-z]+".r`. Parameterless
extensions take no parens, so the call site reads identically to Scala's
postfix-`.r` on `StringOps`. The extension is brought into scope by
`import parsyl.*` (or any selective import that pulls in this function).

    extension (s: string)
        r -> Parser[string] = regex(s)


skip_ws / lex
-------------

ASCII whitespace handling. `skip_ws(p)` skips leading whitespace, then
runs `p`. `lex(p)` runs `skip_ws(p)` and additionally consumes trailing
whitespace, so lex-built parsers compose naturally — each leaves the
cursor on the next non-whitespace byte.

    is_ws_byte(b: byte) -> bool =
        b == 0x20u8 || b == 0x09u8 || b == 0x0Au8 || b == 0x0Du8

    skip_ws[A](p: Parser[A]) -> Parser[A] =
        Parser[A]((inp: Input) ->
            var i = inp.offset
            while i < len(inp.source) && is_ws_byte(inp.source[i]) do
                i = i + 1
            p(Input(inp.source, i)))

    lex[A](p: Parser[A]) -> Parser[A] =
        Parser[A]((inp: Input) ->
            skip_ws(p)(inp) match
                Failure(m, n) -> Failure(m, n)
                Success(v, after) ->
                    var j = after.offset
                    while j < len(after.source) && is_ws_byte(after.source[j]) do
                        j = j + 1
                    Success(v, Input(after.source, j)))


parse_all
---------

Top-level entry: skip leading whitespace, run `p`, then require the
input to be exhausted (modulo trailing whitespace).

    parse_all[A](p: Parser[A], src: string) -> ParseResult[A] =
        skip_ws(p <~ skip_ws(eoi))(mk_input(src))


Common atoms and combinators
----------------------------

`chars_to_str(cs)` builds a string from a char slice via `StrBuilder`.
Useful when a parser accumulates `[]char` and the caller wants a
`string`.

    chars_to_str(cs: []char) -> string =
        val b = new_builder()
        for i in 0..<len(cs) do
            b.write_rune(cs[i])
        b.to_str()

`int_p` parses an optional sign followed by one or more decimal digits,
with surrounding whitespace handled by `lex`. The regex matches
`std.strconv.parse_int`'s grammar exactly, so the conversion is just a
fold over a known-valid string.

    int_p -> Parser[int] =
        lex("-?[0-9]+".r) ^^ ((s: string) -> unwrap(parse_int(s)))

`hex_digit` matches a single hex digit (0-9, a-f, A-F) and returns
the corresponding 0..15 value.

    hex_digit -> Parser[int] =
        accept_if("hex digit", (c: char) ->
            ('0' <= c <= '9') || ('a' <= c <= 'f') || ('A' <= c <= 'F')) ^^
            ((c: char) ->
                if '0' <= c <= '9' then int(c) - int('0')
                else if 'a' <= c <= 'f' then int(c) - int('a') + 10
                else int(c) - int('A') + 10)

`label(p, name)` rewrites the failure message of `p` to read like
"expected NAME". Useful for surfacing meaningful diagnostics from
deep within a grammar.

    label[A](p: Parser[A], name: string) -> Parser[A] =
        Parser[A]((inp: Input) ->
            p(inp) match
                Success(v, n) -> Success(v, n)
                Failure(_, n) -> Failure(s"expected ${name}", n))

`skip(p)` runs `p` for its side effect (cursor advance) and discards
the value.

    skip[A](p: Parser[A]) -> Parser[unit] =
        p ^^ ((_: A) -> ())

`between(open, close, p)` runs `open` then `p` then `close`, returning
only `p`'s value. Equivalent to `open ~> p <~ close` but reads linearly
when the delimiters are simple parsers passed positionally.

    between[O, C, A](open: Parser[O], close: Parser[C], p: Parser[A]) -> Parser[A] =
        seq_l(seq_r(open, p), close)

`chr(c)` matches one specific character.

    chr(c: char) -> Parser[char] =
        accept_if(s"character '${c}'", (x: char) -> x == c)

`one_of(chars)` matches any one character from the given string;
`none_of(chars)` matches any one character that is *not* in the given
string. Both decode `chars` as UTF-8, so multibyte runes work too. Both
fail if the input is at end or the character doesn't fit the set.

    one_of(chars: string) -> Parser[char] =
        val cs = as_bytes(chars)
        accept_if(s"one of '${chars}'", (c: char) ->
            var i = 0
            var found = false
            while i < len(cs) && !found do
                val (r, n) = decode_rune(cs[i : len(cs)])
                if r == c then found = true
                i = i + n
            found)

    none_of(chars: string) -> Parser[char] =
        val cs = as_bytes(chars)
        accept_if(s"none of '${chars}'", (c: char) ->
            var i = 0
            var ok = true
            while i < len(cs) && ok do
                val (r, n) = decode_rune(cs[i : len(cs)])
                if r == c then ok = false
                i = i + n
            ok)

`choice([p1, p2, ...])` is variadic alternation — useful when there are
many alternatives and the chained `|` form gets noisy. Folds the slice
through `or` at construction time, so the runtime path is identical to
hand-written `p1 | p2 | p3`.

    choice[A](ps: []Parser[A]) -> Parser[A] =
        if len(ps) == 0 then failure[A]("empty choice")
        else
            var combined = ps[0]
            var i = 1
            while i < len(ps) do
                combined = or(combined, ps[i])
                i = i + 1
            combined

`take_while(pred)` consumes runes while the predicate holds, returning
the matched span as a `string`. Always succeeds — the empty string is a
valid result. Useful for scanning identifier-like or whitespace-like
runs without the `rep(accept_if(...))` + `chars_to_str` ceremony.

    take_while(pred: (char) -> bool) -> Parser[string] =
        Parser[string]((inp: Input) ->
            var i = inp.offset
            var done = false
            while i < len(inp.source) && !done do
                val (c, n) = decode_rune(inp.source[i : len(inp.source)])
                if !pred(c) then done = true
                else i = i + n
            Success(string(inp.source[inp.offset : i]), Input(inp.source, i)))

`count(n, p)` runs `p` exactly `n` times, returning the collected values.
Fails on the k-th repetition if `p` does. Useful for fixed-width fields,
hex-byte runs, IPv4 octets, etc.

    count[A](n: int, p: Parser[A]) -> Parser[[]A] =
        Parser[[]A]((inp: Input) ->
            var result: []A = []
            var current = inp
            var i = 0
            var failed = false
            var fail_msg = ""
            var fail_at = inp
            while i < n && !failed do
                p(current) match
                    Success(v, after) ->
                        result = append(result, v)
                        current = after
                    Failure(m, at) ->
                        failed = true
                        fail_msg = m
                        fail_at = at
                i = i + 1
            if failed then Failure(fail_msg, fail_at)
            else Success(result, current))

`many_till(p, stop)` repeats `p` until `stop` matches, returning the
values collected. Consumes the matched `stop` (it's a delimiter, not
part of the content). Classic use case: C-style block-comment bodies —
`many_till(any_char, "*/")` collects everything up to and including the
closing delimiter.

    many_till[A, B](p: Parser[A], stop: Parser[B]) -> Parser[[]A] =
        Parser[[]A]((inp: Input) ->
            var result: []A = []
            var current = inp
            var done = false
            var failed = false
            var fail_msg = ""
            var fail_at = inp
            while !done && !failed do
                stop(current) match
                    Success(_, after) ->
                        done = true
                        current = after
                    Failure(_, _) ->
                        p(current) match
                            Success(v, after) ->
                                result = append(result, v)
                                current = after
                            Failure(m, at) ->
                                failed = true
                                fail_msg = m
                                fail_at = at
            if failed then Failure(fail_msg, fail_at)
            else Success(result, current))


Position info and error formatting
----------------------------------

`pos_of(inp)` returns a `(line, col)` pair (both 1-indexed) for the
current cursor position. Walks the source from offset 0 counting
newlines.

    pos_of(inp: Input) -> (int, int) =
        var line = 1
        var col = 1
        var i = 0
        while i < inp.offset do
            if inp.source[i] == 0x0Au8 then
                line = line + 1
                col = 1
            else
                col = col + 1
            i = i + 1
        (line, col)

`format_failure(msg, at)` renders a failure into a multi-line
diagnostic with line number, column, the source line, and a caret
under the offending position. Suitable for direct printing to stderr.

    format_failure(msg: string, at: Input) -> string =
        val (line, col) = pos_of(at)
        var line_start = at.offset
        while line_start > 0 && at.source[line_start - 1] != 0x0Au8 do
            line_start = line_start - 1
        var line_end = at.offset
        while line_end < len(at.source) && at.source[line_end] != 0x0Au8 do
            line_end = line_end + 1
        val src_line = string(at.source[line_start : line_end])
        val b = new_builder()
        b.write(s"line ${line}, col ${col}: ${msg}")
        b.write_byte(0x0Au8)
        b.write(src_line)
        b.write_byte(0x0Au8)
        for i in 0..<col - 1 do
            b.write_byte(0x20u8)
        b.write_byte(0x5Eu8)              // '^'
        b.to_str()


Char-level atoms
----------------

`digit`, `letter`, and `alphanum` are conventional char-level combinators
that every parser library ships under these names. They stay as building
blocks for users composing their own char-level parsers; for full-token
work the regex extension (`"[0-9]+".r`, `"[A-Za-z]+".r`, etc.) is
usually a better fit. Each has a direct unit test below.

    digit -> Parser[char] =
        accept_if("digit", (c: char) -> '0' <= c <= '9')

    letter -> Parser[char] =
        accept_if("letter", (c: char) -> ('a' <= c <= 'z') || ('A' <= c <= 'Z'))

    alphanum -> Parser[char] =
        letter | digit

The two expression-grammar demos that exercise the library against a
real (if toy) target — inline-evaluating `expr` and AST-building `eexpr`
with function-call syntax — live in `parsyl/demo.lsysl` under the same
`module parsyl`.


Tests
-----

    #test
    test_success() -> unit
        val p = success[int](42)
        p(Input(as_bytes("hello"), 0)) match
            Success(v, _) -> expect(v, 42, "success returns its value")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_failure() -> unit
        val p = failure[int]("nope")
        p(Input(as_bytes("hello"), 0)) match
            Success(_, _) -> panic("failure should not succeed")
            Failure(_, _) -> ()

    #test
    test_end_at_end() -> unit
        val p = eoi
        p(Input(as_bytes("ab"), 2)) match
            Success(_, _) -> ()
            Failure(_, _) -> panic("end should succeed at end of input")

    #test
    test_end_not_at_end() -> unit
        val p = eoi
        p(Input(as_bytes("ab"), 0)) match
            Success(_, _) -> panic("end should fail mid-input")
            Failure(_, _) -> ()

    #test
    test_map() -> unit
        val p: Parser[int] = map(success[int](21), (x: int) -> x * 2)
        p(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 42, "map doubles")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_seq_success() -> unit
        val p = seq(success[int](1), success[int](2))
        p(Input(as_bytes(""), 0)) match
            Success((a, b), _) ->
                expect(a, 1, "seq first")
                expect(b, 2, "seq second")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_or_first() -> unit
        val p = or(success[int](1), success[int](2))
        p(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 1, "or takes the first success")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_or_fallback() -> unit
        val p = or(failure[int]("nope"), success[int](2))
        p(Input(as_bytes(""), 0)) match
            Success(v, _) -> expect(v, 2, "or falls back to second on first failure")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_opt_some() -> unit
        val p = opt(success[int](7))
        p(Input(as_bytes(""), 0)) match
            Success(o, _) ->
                o match
                    Some(v) -> expect(v, 7, "opt-Some carries value")
                    None    -> panic("opt of success should be Some")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_opt_none() -> unit
        val p = opt(failure[int]("nope"))
        p(Input(as_bytes("hi"), 2)) match
            Success(o, n) ->
                expect(n.offset, 2, "opt of failure does not advance")
                o match
                    Some(_) -> panic("opt of failure should be None")
                    None    -> ()
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_not_p_match_fails() -> unit
        // At position 0 of "abc", `literal("abc")` would succeed,
        // so `not_p(literal("abc"))` must fail.
        val p = not_p(literal("abc"))
        p(Input(as_bytes("abc"), 0)) match
            Success(_, _) -> panic("not_p should fail when inner succeeds")
            Failure(_, n) -> expect(n.offset, 0, "no advance on failure")

    #test
    test_not_p_no_match_succeeds() -> unit
        // At position 0 of "xyz", `literal("abc")` fails, so not_p succeeds.
        val p = not_p(literal("abc"))
        p(Input(as_bytes("xyz"), 0)) match
            Success(_, n) -> expect(n.offset, 0, "no advance on success")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_not_p_guards_alternative() -> unit
        // Composed: only accept "ab" if NOT followed by "c".
        // At "abd" should match "ab"; at "abc" should fail.
        val guarded = literal("ab") <~ not_p(literal("c"))
        guarded(Input(as_bytes("abd"), 0)) match
            Success(v, n) ->
                expect(n.offset, 2, "consumed 'ab'")
                if v != "ab" then panic("expected 'ab'")
            Failure(m, _) -> panic(s"unexpected failure on 'abd': ${m}")
        guarded(Input(as_bytes("abc"), 0)) match
            Success(_, _) -> panic("should reject 'ab' followed by 'c'")
            Failure(_, _) -> ()

    #test
    test_and_p_match_succeeds() -> unit
        // and_p succeeds with the inner value but does NOT advance.
        val p = and_p(literal("hi"))
        p(Input(as_bytes("hi!"), 0)) match
            Success(v, n) ->
                if v != "hi" then panic("expected 'hi'")
                expect(n.offset, 0, "and_p does not advance")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_and_p_no_match_fails() -> unit
        val p = and_p(literal("hi"))
        p(Input(as_bytes("xyz"), 0)) match
            Success(_, _) -> panic("and_p should fail when inner fails")
            Failure(_, _) -> ()

    #test
    test_and_p_then_consume() -> unit
        // Classic compose: peek that input starts with "ab", then consume.
        // and_p doesn't advance, so the literal still sees "ab" at offset 0.
        val p = and_p(literal("ab")) ~> literal("abc")
        p(Input(as_bytes("abc"), 0)) match
            Success(v, n) ->
                if v != "abc" then panic("expected 'abc'")
                expect(n.offset, 3, "consumed 'abc' after and_p")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_bang_sugar_match_fails() -> unit
        // !p as prefix-operator sugar for not_p(p).
        val p = !(literal("abc"))
        p(Input(as_bytes("abc"), 0)) match
            Success(_, _) -> panic("!p should fail when p succeeds")
            Failure(_, n) -> expect(n.offset, 0, "no advance on failure")

    #test
    test_bang_sugar_no_match_succeeds() -> unit
        val p = !(literal("abc"))
        p(Input(as_bytes("xyz"), 0)) match
            Success(_, n) -> expect(n.offset, 0, "no advance on success")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_amp_sugar_match_succeeds() -> unit
        // &p as prefix-operator sugar for and_p(p).
        val p = &(literal("hi"))
        p(Input(as_bytes("hi!"), 0)) match
            Success(v, n) ->
                if v != "hi" then panic("expected 'hi'")
                expect(n.offset, 0, "and_p does not advance")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_bang_amp_natural_compose() -> unit
        // The headline PEG compose: peek "ab" via &, then consume "ab",
        // guarded against a final "c". Bare-string operands lift to
        // lex(literal(...)) — no `literal` keyword needed.
        val p = &"ab" ~> ("ab" <~ !"c")
        p(Input(as_bytes("abx"), 0)) match
            Success(v, n) ->
                if v != "ab" then panic("expected 'ab'")
                expect(n.offset, 2, "consumed exactly 'ab'")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")
        p(Input(as_bytes("abc"), 0)) match
            Success(_, _) -> panic("should reject 'ab' followed by 'c'")
            Failure(_, _) -> ()

    #test
    test_rep_zero() -> unit
        val p = rep(failure[int]("nope"))
        p(Input(as_bytes("xx"), 0)) match
            Success(xs, n) ->
                expect(len(xs), 0, "rep of always-failing yields empty slice")
                expect(n.offset, 0, "rep does not advance on no matches")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

    #test
    test_rep1_fail_on_zero() -> unit
