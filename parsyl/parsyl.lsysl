        val p = rep1(literal("x"))
        p(Input(as_bytes("xxx"), 0)) match
            Success(vs, n) ->
                expect(len(vs), 3, "rep1 collects three xs")
                expect(n.offset, 3, "rep1 consumes all xs")
            Failure(m, _) -> panic(s"unexpected failure: ${m}")

