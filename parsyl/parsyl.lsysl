    #test
    test_digit_accepts() -> unit
        digit()(Input(as_bytes("3"), 0)) match
            Success(c, n) ->
                if c != '3' then panic(s"expected '3', got '${c}'")
                expect(n.offset, 1, "digit advances by 1")
